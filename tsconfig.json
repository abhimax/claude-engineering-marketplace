{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "plugins/**/*.mjs", "tests/**/*.ts"]
}