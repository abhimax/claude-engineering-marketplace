#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
"$repository_root/node_modules/.bin/tsx" "$repository_root/scripts/validate-marketplace.ts" "$repository_root"

if ! command -v claude >/dev/null 2>&1; then
  printf '%s\n' 'ERROR: Claude Code CLI is required for authoritative manifest and component validation.' >&2
  printf '%s\n' 'Install Claude Code, then rerun ./scripts/validate-marketplace.' >&2
  exit 1
fi

claude plugin validate "$repository_root" --strict
claude plugin validate "$repository_root/plugins/hipaa-p2-review" --strict