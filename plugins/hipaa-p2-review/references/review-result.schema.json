{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Healthcare Pull Request Review Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_status",
    "summary",
    "findings",
    "uncertainties"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "review_status": {
      "enum": ["complete", "incomplete"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "alert",
        "category",
        "evidence_status",
        "confidence",
        "title",
        "location",
        "evidence",
        "risk",
        "recommendation",
        "human_verification_required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HPR-[0-9]{3,}$"
        },
        "alert": {
          "const": "warning"
        },
        "category": {
          "enum": [
            "hardcoded_secret_credential",
            "phi_pii_leakage",
            "unmasked_test_data",
            "encryption_enforcement",
            "endpoint_access_control",
            "dependency_sca_baa"
          ]
        },
        "evidence_status": {
          "enum": ["confirmed", "potential"]
        },
        "confidence": {
          "enum": ["high", "medium", "low"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "start_line", "end_line"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "start_line": {
              "type": "integer",
              "minimum": 1
            },
            "end_line": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "risk": {
          "type": "string",
          "minLength": 1
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "human_verification_required": {
          "type": "boolean"
        }
      }
    }
  }
}